# Cấu hình nhà cung cấp tạo ảnh
# Sao chép tệp này thành image_providers.yaml rồi điền cấu hình của bạn

# Nhà cung cấp đang dùng (ghi đúng tên có trong providers bên dưới)
active_provider: antigravity_image

# Danh sách nhà cung cấp
providers:
  # Google Antigravity tạo ảnh (đăng nhập tài khoản Google, KHÔNG cần API Key)
  # model: auto sẽ tự dùng model ảnh mà tài khoản của bạn được cấp
  antigravity_image:
    type: google_antigravity
    auth: antigravity_oauth
    model: auto
    high_concurrency: false
    default_aspect_ratio: '3:4'

  # Google Gemini tạo ảnh (cần API Key)
  gemini:
    type: google_genai
    api_key: AIzaxxxxxxxxxxxxxxxxxxxxxxxxx
    model: gemini-3-pro-image-preview
    high_concurrency: false  # có bật chạy song song hay không; tài khoản dùng thử GCP 300$ không nên bật

  # Google Vertex AI (chỉ dùng khi bạn đã có credentials GCP)
  vertex:
    type: google_genai
    api_key: your-vertex-api-key
    model: gemini-3-pro-image-preview
    high_concurrency: true  # tài khoản trả phí có thể bật song song

  # Giao thức OpenAI-compatible (API bên thứ ba có hỗ trợ tạo ảnh)
  openai_image:
    type: image_api
    api_key: sk-xxxxxxxxxxxxxxxxxxxx
    base_url: https://your-api-endpoint.com
    model: dall-e-3
    high_concurrency: false
