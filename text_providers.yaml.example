# Cấu hình nhà cung cấp tạo chữ
# Sao chép tệp này thành text_providers.yaml rồi điền cấu hình của bạn

# Nhà cung cấp đang dùng (ghi đúng tên có trong providers bên dưới)
active_provider: antigravity

# Danh sách nhà cung cấp
providers:
  # Google Antigravity (đăng nhập tài khoản Google, KHÔNG cần API Key)
  # Bấm "Đăng nhập Google" ở trang Cài đặt để hoàn tất OAuth, sau đó dùng ngay
  antigravity:
    type: google_antigravity
    auth: antigravity_oauth
    model: gemini-3.1-pro-low   # hoặc 'auto' để tự chọn model mà tài khoản cung cấp
    # base_url có thể bỏ trống; nếu điền sẽ buộc dùng endpoint Cloud Code Assist này
    # base_url: https://daily-cloudcode-pa.googleapis.com

  # OpenAI API chính thức
  openai:
    type: openai_compatible
    api_key: sk-xxxxxxxxxxxxxxxxxxxx
    base_url: https://api.openai.com/v1
    model: gpt-4o

  # Google Gemini (giao thức gốc, cần API Key)
  gemini:
    type: google_gemini
    api_key: AIzaxxxxxxxxxxxxxxxxxxxxxxxxx
    model: gemini-2.0-flash

  # Ví dụ giao thức OpenAI-compatible bên thứ ba (OneAPI, New API...)
  third_party:
    type: openai_compatible
    api_key: sk-xxxxxxxxxxxxxxxxxxxx
    base_url: https://your-api-endpoint.com
    model: gpt-4o

  # Alibaba Tongyi Qianwen
  qwen:
    type: openai_compatible
    api_key: sk-xxxxxxxxxxxxxxxxxxxx
    base_url: https://dashscope.aliyuncs.com/compatible-mode/v1
    model: qwen-max
